# Dolphin CREATE の環境変数。このファイルをコピーして .env.local を作り、値を入れてください。
# 本物の値（キー・パスワード・接続情報）はリポジトリに入れないこと。本番は Vercel のシークレットに登録する。

# 環境：development / test / production
APP_ENV=development

# Supabase（`npx supabase start` を実行すると、ローカル用の値が表示される）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 全権限キー。日次処理など限られたサーバー処理だけで使う。ブラウザには絶対に渡さない。
SUPABASE_SERVICE_ROLE_KEY=

# Claude API（サーバーからのみ呼ぶ。M4 から使う）
ANTHROPIC_API_KEY=
# 使うモデルは config/app.ts の既定値を、必要なときだけここで上書きする
# AI_MODEL=

# 定期実行（Vercel Cron）から日次処理を呼ぶときの秘密トークン（M2 から使う）
CRON_SECRET=

# 広告・GA4・Dolphin の接続情報を暗号化する鍵（32バイトを base64 で。M5 から使う）
# 作り方：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTION_ENCRYPTION_KEY=
